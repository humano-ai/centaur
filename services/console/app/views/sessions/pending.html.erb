<% content_for :title, "Awaiting Approval · Fyndry Console" %>

<div class="mb-8 text-center">
  <%= image_tag "fyndry-lockup-white.svg", alt: "Fyndry", class: "mx-auto h-9 w-auto", width: 497, height: 127 %>
  <p class="page-subtitle mt-4">Operator console.</p>
</div>

<div class="rounded-xl border border-border bg-card p-6 text-center">
  <h2 class="text-lg font-semibold text-foreground">Awaiting approval</h2>
  <p class="mt-2 text-sm text-muted-foreground">
    You're signed in as <span class="text-foreground"><%= current_user.email %></span>, but your account
    is pending approval by an administrator. You'll have access once it's approved.
  </p>

  <div class="mt-6">
    <%= button_to "Sign out", logout_path, method: :delete,
          class: "w-full cursor-pointer rounded border border-border px-4 py-2 text-sm text-muted-foreground transition-colors hover:border-centaur-500/40 hover:text-primary" %>
  </div>
</div>

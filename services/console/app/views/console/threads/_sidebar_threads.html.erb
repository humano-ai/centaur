<%# Sidebar thread list, rendered inside the lazy console_sidebar_threads Turbo
    Frame. The turbo-frame id must match the one in layouts/console.html.erb so
    the deferred fetch replaces the loading placeholder. Cmd/Ctrl-click on a
    thread link adds it to the split-view grid (wired in the console layout). %>
<%= turbo_frame_tag "console_sidebar_threads" do %>
  <% open_thread_keys = params[:thread].to_s.split(",").map(&:strip).reject(&:blank?) %>
  <% if @console_sidebar_threads.blank? %>
    <div class="console-thread-empty">No recent chats</div>
  <% else %>
    <%# Grouped by channel (bb groups its sidebar the same way): groups keep the
        recency order of their newest thread, and the 5-row collapse applies
        across the whole list, not per group. %>
    <% grouped = @console_sidebar_threads.group_by { |thread| console_sidebar_thread_group(thread) } %>
    <% index = -1 %>
    <% grouped.each do |group_label, group_threads| %>
      <%# Slack-style channel row that toggles its threads, like bb's
          project/folder disclosures. Collapsed state is remembered per channel
          in localStorage by the console layout's script. %>
      <div class="console-channel-group" data-console-channel-group="<%= group_label %>">
        <button type="button"
                class="console-channel-toggle"
                aria-expanded="true"
                data-console-channel-toggle
                title="<%= group_label %>">
          <% if console_sidebar_group_dm?(group_threads.first) %>
            <% avatar = console_sidebar_group_avatar_url(group_threads.first) %>
            <% if avatar && avatar["src"] %>
              <%= image_tag avatar["src"],
                            srcset: (avatar["srcset"] ? { avatar["srcset"] => "2x" } : nil),
                            class: "console-channel-avatar-img",
                            alt: "", aria: { hidden: true }, loading: "lazy" %>
            <% else %>
              <span class="console-channel-avatar" aria-hidden="true"><%= console_sidebar_group_initials(group_label) %></span>
            <% end %>
          <% else %>
            <span class="console-channel-hash" aria-hidden="true"><%= console_icon("hash", classes: "size-3.5") %></span>
          <% end %>
          <span class="console-channel-name"><%= group_label %></span>
          <span class="console-channel-count"><%= group_threads.size %></span>
          <span class="console-channel-caret" aria-hidden="true"><%= console_icon("chevron-down", classes: "size-3") %></span>
        </button>
        <div class="console-channel-threads" data-console-channel-threads>
      <% group_threads.each do |thread| %>
        <% index += 1 %>
      <%# Open threads carry their 1-based pane number, rendered as a small
          numeral in the indent gutter (matches the grid order). No filled
          pill on thread rows; the Threads group title keeps its own. %>
      <% pane_index = open_thread_keys.index(thread.thread_key) %>
      <% open_thread = !pane_index.nil? %>
      <% latest_message = @console_sidebar_latest_messages[thread.thread_key] %>
      <% title = console_sidebar_thread_title(thread, latest_message) %>
      <%= link_to console_threads_path(thread: thread.thread_key),
                  class: "console-thread-link #{open_thread ? "console-thread-link-open" : ""}",
                  data: {
                    console_thread_link: true,
                    turbo_frame: "_top",
                    console_pane_index: (pane_index + 1 if open_thread && open_thread_keys.size > 1)
                  }.compact,
                  title: title do %>
        <span class="console-thread-title"><%= title %></span>
        <span class="console-thread-time"><%= local_time(thread.updated_at || thread.created_at, relative: true, format: :compact) %></span>
        <% end %>
      <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
<% end %>

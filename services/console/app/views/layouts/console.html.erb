<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title>Fyndry (Nightly)</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">
    <%= csrf_meta_tags %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <meta name="theme-color" content="#0a0a0a">
    <link rel="icon" href="/icon-dark.svg" type="image/svg+xml" data-console-favicon>
    <link rel="apple-touch-icon" href="/pwa-icon-192.png">
    <script>
      (() => {
        const storageKey = "centaur-console-theme";
        const storageSourceKey = "centaur-console-theme-source";
        const validTheme = (theme) => theme === "light" || theme === "dark";
        const systemTheme = () => {
          if (window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches) {
            return "light";
          }
          return "dark";
        };
        const storedTheme = () => {
          try {
            const theme = localStorage.getItem(storageKey);
            const source = localStorage.getItem(storageSourceKey);
            return source === "manual" && validTheme(theme) ? theme : null;
          } catch (_error) {
            return null;
          }
        };
        const preference = () => storedTheme() || "system";
        const resolveTheme = () => storedTheme() || systemTheme();
        const applyTheme = (theme) => {
          const nextTheme = validTheme(theme) ? theme : systemTheme();
          document.documentElement.dataset.consoleTheme = nextTheme;

          const favicon = document.querySelector("[data-console-favicon]");
          if (favicon) {
            favicon.setAttribute("href", nextTheme === "light" ? "/icon-light.svg" : "/icon-dark.svg");
          }

          return nextTheme;
        };

        window.ConsoleTheme = {
          apply: applyTheme,
          persist: (theme) => {
            if (theme === "system") {
              try {
                localStorage.removeItem(storageKey);
                localStorage.removeItem(storageSourceKey);
              } catch (_error) {
                // Theme still follows the system for this page load when storage is unavailable.
              }
              return applyTheme(systemTheme());
            }

            const nextTheme = applyTheme(theme);
            try {
              localStorage.setItem(storageKey, nextTheme);
              localStorage.setItem(storageSourceKey, "manual");
            } catch (_error) {
              // Theme still applies for this page load when storage is unavailable.
            }
            return nextTheme;
          },
          preference: preference,
          resolve: resolveTheme
        };

        applyTheme(resolveTheme());

        if (window.matchMedia) {
          const mediaQuery = window.matchMedia("(prefers-color-scheme: light)");
          const syncSystemTheme = () => {
            if (!storedTheme()) applyTheme(resolveTheme());
          };

          if (typeof mediaQuery.addEventListener === "function") {
            mediaQuery.addEventListener("change", syncSystemTheme);
          } else if (typeof mediaQuery.addListener === "function") {
            mediaQuery.addListener(syncSystemTheme);
          }
        }
      })();
    </script>

    <%# Tailwind is compiled by the standalone binary into app/assets/builds/tailwind.css.
        See config/tailwind.config.js for the centaur/ink palette and radii overrides. %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
      ::selection { background: var(--primary); color: var(--background); }
      html[data-console-theme="dark"] { color-scheme: dark; }
      .glow { filter: drop-shadow(0 0 14px var(--overlay-strong)); }
      *::-webkit-scrollbar { width: 10px; height: 10px; }
      *::-webkit-scrollbar-track { background: var(--background); }
      *::-webkit-scrollbar-thumb { background: var(--input); border-radius: 1px; }
      *::-webkit-scrollbar-thumb:hover { background: var(--primary); }

      .console-shell {
        display: flex;
        height: 100%;
        overflow: hidden;
        background: var(--background);
      }

      /* While descoped, the body becomes a column: banner on top, shell
         filling the rest. Scoped so the normal layout is untouched. */
      .console-descoped {
        display: flex;
        flex-direction: column;
      }

      .console-descoped .console-shell {
        flex: 1 1 auto;
        min-height: 0;
        height: auto;
      }

      .console-descope-banner {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        padding: 0.5rem 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        color: #1c1205;
        background: #f59e0b;
      }

      .console-descope-restore {
        cursor: pointer;
        border-radius: 0.25rem;
        border: 1px solid #1c1205;
        padding: 0.125rem 0.625rem;
        font-weight: 700;
        color: #fbbf24;
        background: #1c1205;
        transition: opacity 120ms ease;
      }

      .console-descope-restore:hover {
        opacity: 0.85;
      }

      .console-sidebar {
        width: 18rem;
        flex: 0 0 auto;
        display: flex;
        min-height: 0;
        flex-direction: column;
        border-right: 1px solid var(--overlay-2);
        background: var(--background);
        transition: width 160ms ease;
      }

      .console-sidebar-top {
        display: flex;
        height: 3.5rem;
        align-items: center;
        gap: 0.75rem;
        padding: 0 1.5rem;
      }

      .console-brand {
        display: flex;
        min-width: 0;
        flex: 1;
        align-items: center;
        color: var(--foreground);
      }

      .console-brand img {
        height: 1.75rem;
        width: auto;
      }

      .console-brand-glyph {
        display: none;
        height: 2rem;
        width: 2rem;
        place-items: center;
        border-radius: 0.5rem;
      }

      .console-brand-glyph img {
        height: 1.75rem;
        width: 1.75rem;
        object-fit: contain;
      }

      .console-sidebar-scroll {
        min-height: 0;
        flex: 1;
        overflow-y: auto;
        padding: 0.25rem 0.75rem 1rem;
      }

      .console-nav-list {
        display: grid;
        gap: 0.125rem;
        margin-bottom: 0.125rem;
      }

      .console-nav-link {
        display: flex;
        min-width: 0;
        height: 2.35rem;
        align-items: center;
        gap: 0.625rem;
        border-radius: 0.875rem;
        padding: 0 0.875rem;
        color: var(--muted-foreground);
        text-decoration: none;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-nav-link:hover {
        background: var(--overlay-1);
        color: var(--foreground);
      }

      .console-nav-link-active {
        background: var(--overlay-2);
        color: var(--foreground);
      }

      .console-nav-icon {
        display: grid;
        width: 1rem;
        flex: 0 0 auto;
        place-items: center;
        color: currentColor;
      }

      .console-nav-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.875rem;
        font-weight: 500;
      }

      /* Keep stacked group tabs (Scheduled / Workflows / New chat / Chats) on the same
         0.125rem rhythm as the nav rows above them. */
      .console-thread-group + .console-thread-group {
        margin-top: 0.125rem;
      }

      .console-thread-group-title {
        display: flex;
        height: 2.35rem;
        align-items: center;
        gap: 0.625rem;
        border-radius: 0.875rem;
        padding: 0 0.875rem;
        color: var(--muted-foreground);
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-thread-group-title:hover {
        background: var(--overlay-1);
        color: var(--foreground);
      }

      .console-thread-group-title-active {
        background: var(--overlay-2);
        color: var(--foreground);
      }

      .console-thread-list {
        display: grid;
        gap: 0.3rem;
        margin-top: 0.3rem;
      }

      .console-thread-link {
        position: relative;
        display: grid;
        min-width: 0;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 0.5rem;
        border-radius: var(--radius-md);
        padding: 0.25rem 0.5rem;
        color: var(--muted-foreground);
        font-size: var(--text-sm, 0.8125rem);
        text-decoration: none;
        transition: background 120ms ease, color 120ms ease;
      }

      /* An open thread: bright title plus a marker in the indent gutter — no
         filled pill on thread rows. A single open thread gets a dot; once a
         second pane opens, rows carry data-console-pane-index and the marker
         becomes the pane number in grid order. */
      .console-thread-link-open {
        color: var(--foreground);
      }

      .console-thread-link-open[data-console-pane-index] {
        padding-left: 1.5rem;
      }

      .console-thread-link-open[data-console-pane-index]::before {
        content: attr(data-console-pane-index);
        position: absolute;
        top: 50%;
        left: 0.5rem;
        transform: translateY(-50%);
        color: var(--foreground);
        font-size: 0.6875rem;
        font-weight: 700;
        line-height: 1;
      }

      .console-thread-separator {
        height: 1px;
        margin: 0.625rem 0.5rem 0.25rem;
        background: var(--border-seam);
      }

      .console-channel-toggle {
        display: flex;
        width: 100%;
        align-items: center;
        gap: 0.375rem;
        border-radius: var(--radius-md);
        padding: 0.3125rem 0.5rem;
        color: var(--foreground);
        font-size: var(--text-sm, 0.8125rem);
        font-weight: 500;
        text-align: left;
        transition: background 180ms cubic-bezier(0.16, 1, 0.3, 1), color 180ms;
      }

      .console-channel-toggle:hover {
        background: var(--state-hover);
        color: var(--foreground);
      }

      .console-channel-caret {
        display: grid;
        place-items: center;
        color: var(--subtle-foreground);
        transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .console-channel-toggle[aria-expanded="false"] .console-channel-caret {
        transform: rotate(-90deg);
      }

      .console-channel-hash {
        display: grid;
        place-items: center;
        color: var(--subtle-foreground);
      }

      .console-channel-avatar {
        display: grid;
        height: 1rem;
        width: 1rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 999px;
        background: var(--muted);
        color: var(--muted-foreground);
        font-size: 0.5625rem;
        font-weight: 600;
        line-height: 1;
      }

      .console-channel-avatar-img {
        height: 1rem;
        width: 1rem;
        flex: 0 0 auto;
        border-radius: 999px;
        object-fit: cover;
      }

      .console-channel-name {
        min-width: 0;
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .console-channel-count {
        color: var(--subtle-foreground);
        font-size: var(--text-2xs, 0.625rem);
        font-variant-numeric: tabular-nums;
      }

      .console-channel-threads[hidden] {
        display: none;
      }

      /* No rail: bb marks the thread you're in with a box, and the rows sit
         directly under their channel. */
      .console-channel-threads {
        padding-left: 0;
      }

      .console-thread-group-label {
        padding: 0.5rem 0.5rem 0.125rem;
        color: var(--subtle-foreground);
        font-size: var(--text-2xs, 0.625rem);
        font-weight: 500;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .console-thread-group-label:first-child {
        padding-top: 0.25rem;
      }

      .console-thread-link:hover {
        background: var(--state-hover);
        color: var(--foreground);
      }

      /* Active thread reads as a resting hover fill — no border, like bb. */
      .console-thread-link-active,
      .console-thread-link-open {
        background: var(--state-active);
        color: var(--foreground);
        font-weight: 500;
      }

      .console-thread-link-hidden {
        display: none;
      }

      .console-thread-title {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.875rem;
        font-weight: 500;
      }

      .console-thread-time {
        color: var(--muted-foreground);
        font-size: 0.75rem;
      }

      .console-panel-close {
        display: grid;
        height: 1.75rem;
        width: 1.75rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 0.5rem;
        color: var(--muted-foreground);
        transition: background 120ms ease, color 120ms ease;
      }

      .console-panel-close:hover {
        background: var(--overlay-2);
        color: var(--foreground);
      }

      .console-thread-share-wrap {
        position: relative;
        flex: 0 0 auto;
      }

      .console-thread-share-trigger {
        display: grid;
        height: 1.75rem;
        width: 1.75rem;
        cursor: pointer;
        place-items: center;
        border-radius: 0.5rem;
        color: var(--muted-foreground);
        transition: background 120ms ease, color 120ms ease;
      }

      .console-thread-share-trigger:hover {
        background: var(--overlay-2);
        color: var(--foreground);
      }

      .console-share-dialog {
        width: min(28rem, calc(100vw - 2rem));
        margin: auto;
        border: 1px solid var(--overlay-3);
        border-radius: 0.875rem;
        background: var(--card);
        color: var(--primary);
        padding: 0;
        box-shadow: 0 24px 70px rgba(0, 0, 0, 0.58);
      }

      .console-share-dialog::backdrop {
        background: rgba(0, 0, 0, 0.66);
        backdrop-filter: blur(2px);
      }

      .console-share-dialog-copy {
        padding: 1.5rem 1.5rem 1.25rem;
      }

      .console-share-dialog-copy h2 {
        color: var(--foreground);
        font-size: 1rem;
        font-weight: 600;
      }

      .console-share-dialog-copy > p:not(.console-share-dialog-error) {
        margin-top: 0.75rem;
        color: var(--muted-foreground);
        font-size: 0.875rem;
        line-height: 1.5;
      }

      .console-share-dialog-error {
        margin-top: 0.75rem;
        color: #fca5a5;
        font-size: 0.75rem;
      }

      .console-share-dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        border-top: 1px solid var(--overlay-2);
        padding: 1rem 1.5rem;
      }

      .console-share-dialog-actions .btn-primary,
      .console-share-dialog-actions .btn-secondary {
        min-width: 6.5rem;
        padding-top: 0.5rem;
        padding-bottom: 0.5rem;
        text-align: center;
      }

      .console-share-dialog-actions .btn-primary:disabled {
        cursor: wait;
        opacity: 0.6;
      }

      .console-thinking {
        min-width: 0;
        padding: 0.125rem 0;
      }

      .console-thinking-summary {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 0.4rem;
        cursor: pointer;
        list-style: none;
        user-select: none;
        color: var(--muted-foreground);
        font-size: 0.8125rem;
        line-height: 1.35;
        border-radius: 0.5rem;
        padding: 0.2rem 0.5rem;
        margin: -0.2rem -0.5rem;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-thinking-summary::-webkit-details-marker {
        display: none;
      }

      .console-thinking-summary:focus,
      .console-thinking-command-row:focus {
        outline: none;
      }

      .console-thinking-summary:focus-visible,
      .console-thinking-command-row:focus-visible {
        outline: none;
      }

      .console-thinking-summary:hover {
        background: var(--overlay-1);
        color: var(--primary);
      }

      .console-thinking-chevron {
        display: grid;
        flex: 0 0 auto;
        margin-left: 0.125rem;
        place-items: center;
        /* Optical centering: settle the arrow onto the lowercase x-band that
           dominates the row text (geometric center reads slightly high). */
        position: relative;
        top: 1px;
        transition: transform 120ms ease;
      }

      .console-thinking[open] .console-thinking-chevron {
        transform: rotate(90deg);
      }

      .console-thinking-preview {
        flex: 1 1 auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--muted-foreground);
      }

      .console-thinking-title {
        flex: 0 0 auto;
        color: var(--primary);
        font-weight: 500;
        white-space: nowrap;
      }

      .console-thinking-failed,
      .console-command-status {
        color: #f87171;
      }

      /* The comma hugs the group title: pull the label back across the flex
         gap so it reads "Ran 2 commands, 1 failed". */
      .console-thinking-failed {
        flex: 0 0 auto;
        margin-left: -0.4rem;
        white-space: nowrap;
      }

      .console-thinking-failed::before {
        content: ",";
        color: var(--muted-foreground);
        margin-right: 0.35rem;
      }

      .console-thinking[open] .console-thinking-preview {
        display: none;
      }

      .console-thinking-body {
        margin-top: 0.35rem;
        color: var(--muted-foreground);
      }

      /* Roomy enough that adjacent rows' hover pills (which extend 0.2rem
         beyond their row) don't touch. */
      .console-thinking-command-list {
        display: grid;
        gap: 0.4rem;
        margin-top: 0.55rem;
      }

      .console-thinking-command {
        min-width: 0;
      }

      .console-thinking-command-row {
        display: flex;
        min-width: 0;
        align-items: baseline;
        gap: 0.45rem;
        cursor: pointer;
        list-style: none;
        color: var(--muted-foreground);
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 0.8125rem;
        line-height: 1.45;
        user-select: none;
        border-radius: 0.5rem;
        padding: 0.2rem 0.5rem;
        margin: -0.2rem -0.5rem;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-thinking-command-row::-webkit-details-marker {
        display: none;
      }

      .console-thinking-command-row:hover {
        background: var(--overlay-1);
        color: var(--primary);
      }

      .console-command-prompt {
        flex: 0 0 auto;
        color: var(--muted-foreground);
      }

      .console-command-prompt--failed {
        color: #fb7185;
      }

      .console-command-text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .console-command-status {
        flex: 0 0 auto;
        font-family: inherit;
      }

      .console-thinking-command-chevron {
        display: grid;
        flex: 0 0 auto;
        margin-left: auto;
        place-items: center;
        color: var(--muted-foreground);
        /* Optical centering onto the lowercase x-band (baseline alignment
           floats the icon ~2px high). */
        position: relative;
        top: 2px;
        transition: transform 120ms ease;
      }

      .console-thinking-command[open] .console-thinking-command-chevron {
        transform: rotate(90deg);
      }

      /* The box chrome hangs in the same 0.5rem gutter as the row hover
         pills, so its inner text (and the $ prompt) sits on the same vertical
         line as the command rows above it. */
      .console-thinking-command-output {
        margin: 0.45rem -0.5rem 0.6rem;
        max-height: 18rem;
        overflow: auto;
        border: 1px solid var(--overlay-2);
        border-radius: 0.5rem;
        background: var(--overlay-1);
        color: var(--muted-foreground);
      }

      .console-thinking-command-full {
        border-bottom: 1px solid var(--overlay-1);
      }

      .console-thinking-command-output pre {
        margin: 0;
        padding: 0.6rem calc(0.5rem - 1px);
        white-space: pre-wrap;
        word-break: break-word;
        font-family: 'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 0.8125rem;
        line-height: 1.45;
      }

      .console-thinking-command-full {
        color: var(--primary);
      }

      .console-thinking-command-result {
        color: var(--muted-foreground);
      }

      .console-thinking-command-empty {
        padding: 0.6rem calc(0.5rem - 1px);
        color: var(--muted-foreground);
        font-size: 0.75rem;
      }

      .console-thread-empty,
      .console-thread-show-all {
        display: block;
        width: 100%;
        cursor: pointer;
        padding: 0.45rem 0.75rem 0.45rem 2.5rem;
        color: var(--muted-foreground);
        font-size: 0.8125rem;
        text-decoration: none;
        text-align: left;
      }

      .console-thread-show-all:hover {
        color: var(--muted-foreground);
      }

      .console-thread-show-all[hidden] {
        display: none;
      }

      .console-sidebar-account {
        position: relative;
        border-top: 1px solid var(--overlay-2);
      }

      .console-account-button {
        display: flex;
        height: 3.625rem;
        min-width: 0;
        width: 100%;
        cursor: pointer;
        align-items: center;
        gap: 0.625rem;
        padding: 0 1.5rem;
        text-align: left;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-account-button:hover,
      .console-account-button[aria-expanded="true"] {
        background: var(--overlay-1);
      }

      .console-user-avatar {
        display: grid;
        height: 1.75rem;
        width: 1.75rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: 999px;
        background: var(--overlay-3);
        color: var(--foreground);
        font-size: 0.75rem;
        font-weight: 700;
      }

      .console-account-email {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--muted-foreground);
        font-size: 0.75rem;
      }

      .console-account-menu {
        position: absolute;
        right: 0.75rem;
        bottom: 4.125rem;
        left: 0.75rem;
        z-index: 30;
        overflow: hidden;
        border: 1px solid var(--overlay-3);
        border-radius: 0.875rem;
        background: var(--card);
        padding: 0.5rem;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.4);
      }

      .console-account-menu[hidden] {
        display: none;
      }

      .console-account-menu-line {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        padding: 0.5rem 0.625rem;
        color: var(--muted-foreground);
        font-size: 0.75rem;
      }

      .console-account-menu-muted {
        color: var(--ring);
      }

      .console-account-menu-separator {
        height: 1px;
        margin: 0.375rem 0.25rem;
        background: var(--overlay-2);
      }

      .console-account-menu form {
        margin: 0;
      }

      .console-account-menu-button,
      .console-signout-button {
        display: flex;
        height: 2.25rem;
        width: 100%;
        cursor: pointer;
        align-items: center;
        justify-content: flex-start;
        gap: 0.5rem;
        border-radius: 0.625rem;
        padding: 0 0.625rem;
        color: var(--muted-foreground);
        font: inherit;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.25rem;
        transition: background 120ms ease, color 120ms ease;
      }

      .console-account-menu-button:hover,
      .console-signout-button:hover {
        background: var(--overlay-1);
        color: var(--foreground);
      }

      /* The install item is hidden until beforeinstallprompt fires; the
         explicit rule is needed because display: flex above would otherwise
         override the hidden attribute. */
      .console-account-menu-button[hidden] {
        display: none;
      }

      .console-main {
        display: flex;
        height: 100%;
        min-width: 0;
        min-height: 0;
        flex: 1;
        flex-direction: column;
        overflow-y: auto;
      }

      .console-main-threads {
        overflow: hidden;
      }

      .console-main-page {
        width: 100%;
        max-width: 80rem;
        margin: 0 auto;
        padding: 1.35rem 2rem 2.5rem;
      }

      .console-main-thread-frame {
        display: flex;
        flex: 1;
        min-height: 0;
        overflow: hidden;
        flex-direction: column;
        padding: 1.35rem 2rem 0;
      }

      .console-thread-content {
        width: 100%;
        max-width: 52rem;
        margin-left: auto;
        margin-right: auto;
      }

      .console-thread-detail-header {
        display: flex;
        justify-content: center;
        flex: 0 0 auto;
        border-bottom: 1px solid var(--overlay-2);
      }

      .console-thread-detail-header > .console-thread-content,
      #thread-transcript-scroll > .console-thread-content {
        flex: 0 0 auto;
      }

      /* Transcript scroll containers hold a single content child inside a
         column-reverse flex, which makes the scroll origin the bottom: threads
         open already scrolled to the newest message, with no post-render JS
         jump and no reflow drift when webfonts land. */
      .console-transcript-scroll {
        display: flex;
        flex-direction: column-reverse;
      }

      #thread-transcript-scroll {
        align-items: center;
        /* Reserve symmetric scrollbar gutters so the centered transcript
           column lines up with the (non-scrolling) header above it. */
        scrollbar-gutter: stable both-edges;
      }

      .console-markdown {
        min-width: 0;
      }

      /* markdown_table interpolates Tailwind border classes inside a Ruby
         string, so the compiled build can drop them and the borders fall back
         to currentColor. Scope the real theme colors here instead. */
      .console-markdown table th {
        border-bottom: 1px solid var(--overlay-3);
      }

      .console-markdown table td {
        border-bottom: 1px solid var(--overlay-2);
      }

      .console-markdown-link {
        overflow-wrap: anywhere;
        word-break: normal;
      }

      .console-message-stack {
        min-width: 0;
      }

      .console-message-images {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.75rem;
        max-width: 100%;
      }

      .console-message-image {
        display: block;
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: min(28rem, 60vh);
        border: 1px solid var(--overlay-3);
        border-radius: 0.75rem;
        object-fit: contain;
      }

      .console-message-timestamp {
        min-height: 1.25rem;
        padding-top: 0.375rem;
        color: var(--muted-foreground);
        font-size: 0.75rem;
        line-height: 0.875rem;
        opacity: 0;
        transition: opacity 120ms ease;
      }

      .group:hover .console-message-timestamp,
      .group:focus-within .console-message-timestamp {
        opacity: 1;
      }

      /* Chat composer — the full-page New-chat card and the dock pinned under
         open transcripts share one box; the dock only adds placement. No
         separator rule: the rounded box already reads as the boundary, and a
         full-bleed hairline over the narrower transcript column looks off. */
      .console-composer-dock {
        flex: 0 0 auto;
        padding: 0.25rem 0 1rem;
      }

      .console-composer-dock--panel {
        padding: 0.6rem 0.75rem 0.75rem;
      }

      .console-composer-box {
        position: relative;
        display: flex;
        flex-direction: column;
        min-height: 68px;
        border: 1px solid var(--border);
        border-radius: var(--radius-xl);
        background: var(--background);
        box-shadow: var(--shadow-lift);
        padding: 0;
        transition: border-color 180ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      /* bb expresses focus through the caret alone — no ring, no border flash. */
      .console-composer-box:focus-within {
        border-color: var(--border);
      }

      .console-composer-input {
        width: 100%;
        flex: 1 1 auto;
        resize: none;
        border: 0;
        background: transparent;
        padding: 0.75rem 1rem 0.25rem;
        color: var(--foreground);
        font-size: var(--text-sm, 0.8125rem);
        line-height: 1.625;
        outline: none;
      }

      .console-composer-input::placeholder {
        color: var(--subtle-foreground);
        font-weight: 300;
        opacity: 0.7;
      }


      .console-composer-controls {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
        padding: 0.375rem 0.5rem 0.5rem 0.875rem;
      }

      .console-composer-spacer {
        flex: 1;
      }

      /* Pinned harness/model text in the composer's picker slot. */
      .console-composer-pinned-model {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        min-width: 0;
        max-width: 16rem;
        padding: 0 0.25rem;
        color: var(--subtle-foreground);
        font-size: var(--text-xs, 0.75rem);
        line-height: 1.1;
      }

      /* Model picker: a pill trigger opening a popover that reuses the
         account-menu panel/item classes, so both dropdowns share one design. */
      .console-composer-model {
        position: relative;
        min-width: 0;
      }

      .console-composer-model-trigger {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        height: 2rem;
        max-width: 16rem;
        border: 0;
        border-radius: var(--radius-sm);
        background: transparent;
        box-shadow: none;
        padding: 0 0.25rem;
        color: var(--muted-foreground);
        font-size: var(--text-xs, 0.75rem);
        font-weight: 400;
        line-height: 1.1;
        transition: color 180ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .console-composer-model-trigger:hover,
      .console-composer-model-trigger[aria-expanded="true"] {
        background: transparent;
        color: var(--foreground);
      }

      .console-composer-model-chevron svg {
        color: color-mix(in oklab, var(--subtle-foreground) 75%, transparent);
      }

      .console-composer-model-chevron {
        display: grid;
        place-items: center;
        transform: rotate(90deg);
        transition: transform 180ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .console-composer-model-trigger[aria-expanded="true"] .console-composer-model-chevron {
        transform: rotate(270deg);
      }

      /* The picker sits just left of the send button, so the popover hangs
         from its right edge. It scrolls when the composer script caps its
         height to keep it inside the viewport. */
      /* The trigger is a narrow text control, so the menu hangs from its LEFT
         edge and opens upward — a right-anchored menu ran off to the left of
         the composer, outside the content column. */
      .console-composer-model-menu {
        top: auto;
        right: auto;
        bottom: calc(100% + 0.4rem);
        left: 0;
        width: 15rem;
        max-width: calc(100vw - 2rem);
        overflow-y: auto;
      }

      /* Flipped by the composer script when the space below the pill can't
         fit the menu (docked composers sit at the bottom of the window). */
      .console-composer-model-menu--above {
        top: calc(100% + 0.4rem);
        bottom: auto;
      }

      /* Root rows of the picker menu: setting name left, current value and a
         chevron on the right (codex-app style). */
      .console-composer-menu-value {
        margin-left: auto;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--muted-foreground);
        font-weight: 400;
      }

      .console-composer-menu-chevron {
        display: grid;
        flex: 0 0 auto;
        place-items: center;
        color: var(--muted-foreground);
      }

      .console-composer-model-option-label {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        flex: 1;
        text-align: left;
      }

      .console-composer-model-check {
        display: grid;
        place-items: center;
        color: var(--foreground);
      }

      /* "Thinking…" placeholder while a turn is executing, painted both by
         the server (_thinking_indicator) and the composer's optimistic JS. */
      /* bb's working cue: a sheen sweeping across the text itself rather than
         the whole line fading in and out. */
      .console-thinking-pending {
        display: flex;
        align-items: center;
        min-height: 1.75rem;
        margin-top: 1rem;
        padding: 0 0.5rem;
        color: var(--muted-foreground);
        font-size: var(--text-sm, 0.8125rem);
        line-height: 1.625;
        background: linear-gradient(
          90deg,
          color-mix(in srgb, var(--foreground) 45%, transparent) 0%,
          var(--foreground) 50%,
          color-mix(in srgb, var(--foreground) 45%, transparent) 100%
        );
        background-size: 200% 100%;
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: console-shine 2s linear infinite;
      }

      @keyframes console-shine {
        from { background-position: 200% 0; }
        to { background-position: -200% 0; }
      }

      @media (prefers-reduced-motion: reduce) {
        .console-thinking-pending {
          animation: none;
          background: none;
          -webkit-text-fill-color: currentColor;
          color: var(--muted-foreground);
        }
      }

      .console-composer-send {
        display: grid;
        height: 2rem;
        min-width: 2rem;
        flex: 0 0 auto;
        place-items: center;
        border-radius: var(--radius-md);
        background: var(--foreground);
        color: var(--background);
        padding: 0 0.5rem;
        transition: background 180ms cubic-bezier(0.16, 1, 0.3, 1), opacity 180ms;
      }

      .console-composer-send:hover {
        background: color-mix(in oklab, var(--foreground) 90%, transparent);
      }

      .console-composer-send:disabled {
        pointer-events: none;
        opacity: 0.5;
      }

      /* Full-page New-chat composer. Its resting state sits a bit above
         vertical center (the claude.ai-style resting height) and matches the
         transcript column width so it reads as an empty chat, not a separate
         page. Once submitted, it fills the available transcript height and
         bottom-aligns the optimistic turn like an opened conversation. */
      .console-new-chat {
        width: 100%;
        max-width: 48rem;
        margin-top: 28vh;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .console-new-chat--optimistic {
        align-self: stretch;
        max-width: 52rem;
        margin-top: 0;
        padding: 1.5rem 0;
        justify-content: flex-end;
      }

      .console-new-chat-title {
        color: var(--foreground);
        font-size: 1.25rem;
        font-weight: 600;
        text-align: center;
      }


      .console-control-tabs {
        display: flex;
        gap: 0.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid var(--overlay-2);
        /* Too many tabs to fit a phone width: scroll them horizontally rather
           than clipping the trailing ones off the edge. */
        overflow-x: auto;
        scrollbar-width: none;
      }

      .console-control-tabs::-webkit-scrollbar {
        display: none;
      }

      .console-control-tab {
        margin-bottom: -1px;
        flex: 0 0 auto;
        padding: 0.625rem 0.75rem;
        border-bottom: 1px solid transparent;
        color: var(--muted-foreground);
        font-size: 0.875rem;
        font-weight: 500;
        white-space: nowrap;
        text-decoration: none;
        transition: border-color 120ms ease, color 120ms ease;
      }

      .console-control-tab:hover {
        color: var(--foreground);
      }

      .console-control-tab-active {
        border-color: var(--primary);
        color: var(--foreground);
      }

      .console-run-row {
        background: rgba(9, 9, 11, 0.45);
        color: var(--muted-foreground);
        box-shadow: inset 0 0 0 1px var(--overlay-1);
      }

      .console-run-status {
        color: var(--primary);
      }

      .console-run-id {
        color: var(--ring);
      }







      /* Amber notice boxes (thread-DB unavailable, managed secret) keep their
         translucent amber-on-dark look in dark mode, but that washes out on the
         light background; match the solid descope-banner treatment instead. */
      html[data-console-theme="light"] .console-amber-note {
        background: #f59e0b;
        border-color: #b45309;
        color: #1c1205;
        font-weight: 600;
      }



      html[data-console-theme="light"] .console-brand-lockup img,
      html[data-console-theme="light"] .console-brand-glyph img {
        filter: invert(1) drop-shadow(0 0 14px var(--overlay-3));
      }




























































      /* Toggle chips (filter tabs, HTTP methods): the component's @apply'd
         ink colors compile to raw values, so the utility-class remaps above
         don't reach them -- restyle the component classes directly. */










      /* Tailwind v4 puts divide-y borders on `> :not(:last-child)` (border-bottom),
         not on the v3 `~` sibling selector — the first child carries a divider too,
         so the recolor must cover it or the first row's border stays ink-dark. */





      /* Composer: plain-CSS component classes, so the utility-class remaps
         above never reach them — they need their own light overrides. */











      /* The mobile top bar (hamburger + brand) and the drawer scrim are hidden
         on desktop; the media query below turns them on for narrow viewports. */
      .console-mobile-bar {
        display: none;
        flex: 0 0 auto;
        position: sticky;
        top: 0;
        z-index: 30;
        height: 3.25rem;
        align-items: center;
        gap: 0.75rem;
        padding: 0 0.75rem;
        border-bottom: 1px solid var(--overlay-2);
        background: rgba(5, 5, 6, 0.92);
        backdrop-filter: blur(8px);
      }

      .console-mobile-nav-toggle {
        display: grid;
        height: 2.25rem;
        width: 2.25rem;
        flex: 0 0 auto;
        cursor: pointer;
        place-items: center;
        border-radius: 0.625rem;
        color: var(--primary);
        transition: background 120ms ease, color 120ms ease;
      }

      .console-mobile-nav-toggle:hover {
        background: var(--overlay-2);
        color: var(--foreground);
      }

      .console-mobile-brand {
        display: flex;
        min-width: 0;
        align-items: center;
        color: var(--foreground);
        text-decoration: none;
      }

      .console-mobile-brand img {
        height: 1.4rem;
        width: auto;
      }

      .console-scrim {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 40;
        background: rgba(0, 0, 0, 0.55);
        opacity: 0;
        pointer-events: none;
        transition: opacity 200ms ease;
      }





      html[data-console-theme="light"] .console-mobile-brand img {
        filter: invert(1) drop-shadow(0 0 14px var(--overlay-3));
      }

      /* Mobile: the 18rem rail squeezes the content to a sliver, so below this
         breakpoint the sidebar becomes an off-canvas drawer toggled from the
         top bar. The main content then gets the full viewport width, and the
         drawer keeps its full labels/brand/account row (no cryptic icon-only
         rail). */
      @media (max-width: 768px) {
        .console-mobile-bar {
          display: flex;
        }

        .console-sidebar {
          position: fixed;
          top: 0;
          bottom: 0;
          left: 0;
          z-index: 50;
          width: 17rem;
          max-width: 82vw;
          transform: translateX(-100%);
          transition: transform 200ms ease;
        }

        .console-nav-open .console-sidebar {
          transform: translateX(0);
          box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);
        }

        .console-scrim {
          display: block;
        }

        .console-nav-open .console-scrim {
          opacity: 1;
          pointer-events: auto;
        }

        .console-main-page {
          padding: 1rem 1rem 1.5rem;
        }

        .console-main-thread-frame {
          padding: 0.85rem 0.85rem 0;
        }
      }
    </style>
  </head>

  <% threads_view = request.path.start_with?("/console/threads") %>
  <% scheduled_tasks_view = request.path.start_with?("/console/scheduled_tasks") %>
  <% workflows_view = request.path.start_with?("/console/workflows") %>
  <% skills_view = request.path.start_with?("/console/skills") %>
  <%# The Control and Data Sync sections are admin-only (each controller enforces
      require_admin server-side); Integrations is for everyone -- it lists the
      public consent start links any team member can use. %>
  <% nav_items = [] %>
  <% if acting_admin? %>
    <% control_matches = [ "/console/principals", "/console/roles", "/console/secrets", "/console/credentials", "/console/oauth_apps", "/console/users" ] %>
    <% nav_items = [
      { label: "Control", icon: "shield-check", path: console_principals_path, matches: control_matches, root_active: true },
      { label: "Data Sync", icon: "database", path: console_etls_path, matches: [ "/console/etls" ] }
    ] %>
  <% end %>
  <% nav_items << { label: "Integrations", icon: "link", path: console_integrations_path, matches: [ "/console/integrations" ] } %>

  <body class="h-full overflow-hidden bg-ink-900 text-zinc-300 font-sans antialiased <%= "console-descoped" if descoped? %>">
    <% if descoped? %>
      <div class="console-descope-banner" role="status">
        <span>Admin permissions paused — viewing the console as an operator</span>
        <%= button_to "Restore admin", console_descope_path, method: :delete,
              class: "console-descope-restore" %>
      </div>
    <% end %>
    <div id="console-shell" class="console-shell">
      <aside class="console-sidebar" aria-label="Console navigation">
        <div class="console-sidebar-top">
          <a href="<%= root_path %>" class="console-brand" aria-label="Fyndry Console">
            <span class="console-brand-glyph">
              <%= image_tag "/icon.svg", alt: "", aria: { hidden: true }, width: 275, height: 275 %>
            </span>
            <span class="console-brand-lockup">
              <%= image_tag "fyndry-lockup-white.svg", alt: "Fyndry", class: "glow", width: 1766, height: 533 %>
            </span>
          </a>
        </div>

        <div class="console-sidebar-scroll">
          <nav class="console-nav-list" aria-label="Console sections">
            <% nav_items.each do |item| %>
              <% active = request.path == item[:path] ||
                          item[:matches].any? { |match| request.path.start_with?(match) } ||
                          (item[:root_active] && request.path == root_path) %>
              <a href="<%= item[:path] %>"
                 class="console-nav-link <%= "console-nav-link-active" if active %>"
                 title="<%= item[:label] %>">
                <span class="console-nav-icon"><%= console_icon(item[:icon], classes: "size-4") %></span>
                <span class="console-nav-label"><%= item[:label] %></span>
              </a>
            <% end %>
          </nav>

          <div class="console-thread-group">
            <a href="<%= console_skills_path %>"
               class="console-thread-group-title <%= "console-thread-group-title-active" if skills_view %>"
               title="Skills">
              <span class="console-nav-icon"><%= console_icon("workflow", classes: "size-4") %></span>
              <span class="console-nav-label">Skills</span>
            </a>
          </div>

          <div class="console-thread-group">
            <a href="<%= console_scheduled_tasks_path %>"
               class="console-thread-group-title <%= "console-thread-group-title-active" if scheduled_tasks_view %>"
               title="Scheduled">
              <span class="console-nav-icon"><%= console_icon("clock", classes: "size-4") %></span>
              <span class="console-nav-label">Scheduled</span>
            </a>
          </div>

          <% if acting_admin? %>
            <div class="console-thread-group">
              <a href="<%= console_workflows_path %>"
                 class="console-thread-group-title <%= "console-thread-group-title-active" if workflows_view %>"
                 title="Workflows">
                <span class="console-nav-icon"><%= console_icon("workflow", classes: "size-4") %></span>
                <span class="console-nav-label">Workflows</span>
              </a>
            </div>
          <% end %>

          <% if console_chat_enabled? %>
            <%# New chat rides the thread-link machinery with the "new" sentinel
                key: plain click opens the full-page composer, Cmd/Ctrl-click
                adds a composer pane to the split view. %>
            <div class="console-thread-group">
              <a href="<%= console_threads_path(thread: Console::ThreadsController::NEW_PANE_KEY) %>"
                 class="console-thread-group-title"
                 aria-label="New chat"
                 title="New chat"
                 data-console-thread-link
                 data-console-new-chat>
                <span class="console-nav-icon"><%= console_icon("plus", classes: "size-4") %></span>
                <span class="console-nav-label">New chat</span>
              </a>
            </div>

            <div class="console-thread-group">
              <%# bb separates the thread list from the nav with a hairline
                  rather than a "Chats" tab: the channel group labels below
                  already say what the list is. %>
              <div class="console-thread-separator" role="separator"></div>
              <%# The thread list is loaded lazily via a Turbo Frame so the
                  unindexed cross-database sessions query never blocks the primary
                  page render. See ApplicationController#init_console_sidebar_threads
                  and Console::ThreadsController#sidebar.

                  The current thread selection rides along on the frame src so the
                  initial out-of-band render can surface and highlight the open
                  thread(s). The wrapper div (not the frame itself — a permanent
                  turbo-frame trips Turbo's frame lifecycle and can wedge the
                  visit progress bar) is turbo-permanent: Turbo Drive carries the
                  loaded list across page visits instead of refetching it, so
                  thread navigation does not repaint the sidebar; the active
                  highlight is re-synced client-side from the page URL. %>
              <div id="console_sidebar_thread_list"
                   class="console-thread-list"
                   data-turbo-permanent>
                <%= turbo_frame_tag "console_sidebar_threads",
                                    src: console_sidebar_threads_path(
                                      thread: (params[:thread].to_s.presence if threads_view)
                                    ),
                                    loading: :lazy do %>
                  <div class="console-thread-empty">Loading chats…</div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <% if current_user %>
          <div class="console-sidebar-account" data-account-menu>
            <button type="button"
                    id="console-account-menu-button"
                    class="console-account-button"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-controls="console-account-menu">
              <span class="console-user-avatar"><%= current_user.email.to_s[0].to_s.upcase.presence || "?" %></span>
              <span class="console-account-email console-account-details" title="<%= current_user.email %>"><%= current_user.email %></span>
            </button>
            <div id="console-account-menu"
                 class="console-account-menu"
                 role="menu"
                 aria-labelledby="console-account-menu-button"
                 hidden>
              <div class="console-account-menu-line" title="<%= current_user.email %>"><%= current_user.email %></div>
              <div class="console-account-menu-line console-account-menu-muted">Fyndry Console</div>
              <div class="console-account-menu-separator"></div>
              <%# PWA install entry point. Hidden unless the browser reports
                  the console is installable (beforeinstallprompt); installing
                  keeps the standalone window plus the manifest's file_handlers
                  registration. %>
              <button type="button"
                      class="console-account-menu-button"
                      data-controller="pwa-install"
                      data-pwa-install-target="banner"
                      data-action="pwa-install#install"
                      hidden
                      role="menuitem"
                      title="Install Fyndry Console as a standalone app"
                      aria-label="Install app">
                <%= console_icon("computer", classes: "size-4") %>
                <span>Install app</span>
              </button>
              <button type="button"
                      class="console-account-menu-button"
                      data-console-theme-toggle
                      role="menuitem"
                      aria-label="Current theme: system. Switch to light mode">
                <span data-console-theme-icon="light" hidden><%= console_icon("sun", classes: "size-4") %></span>
                <span data-console-theme-icon="dark" hidden><%= console_icon("moon", classes: "size-4") %></span>
                <span data-console-theme-icon="system"><%= console_icon("computer", classes: "size-4") %></span>
                <span data-console-theme-label>System mode</span>
              </button>
              <% if acting_admin? %>
                <%= button_to console_descope_path,
                      method: :post,
                      class: "console-signout-button",
                      form: { class: "console-signout-form" },
                      role: "menuitem",
                      title: "Temporarily pause your admin permissions",
                      aria: { label: "View as operator" } do %>
                  <%= console_icon("user-circle", classes: "size-4") %>
                  <span class="console-signout-label">View as operator</span>
                <% end %>
              <% end %>
              <%= button_to logout_path,
                    method: :delete,
                    class: "console-signout-button",
                    form: { class: "console-signout-form" },
                    role: "menuitem",
                    title: "Sign out",
                    aria: { label: "Sign out" } do %>
                <%= console_icon("log-out", classes: "size-4") %>
                <span class="console-signout-label">Sign out</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </aside>

      <main class="console-main <%= "console-main-threads" if threads_view %>">
        <div class="console-mobile-bar">
          <button type="button"
                  id="console-mobile-nav-toggle"
                  class="console-mobile-nav-toggle"
                  aria-label="Open navigation"
                  aria-controls="console-shell"
                  aria-expanded="false"
                  data-console-nav-toggle>
            <%= console_icon("menu", classes: "size-5") %>
          </button>
          <a href="<%= root_path %>" class="console-mobile-brand" aria-label="Fyndry Console">
            <%= image_tag "fyndry-lockup-white.svg", alt: "Fyndry", class: "glow", width: 1766, height: 533 %>
          </a>
        </div>
        <div class="<%= threads_view ? "console-main-thread-frame" : "console-main-page" %>">
          <% if flash[:notice] %>
            <div class="mb-6 rounded border border-ink-600 bg-ink-850/60 px-4 py-3 text-sm text-zinc-400"><%= flash[:notice] %></div>
          <% end %>
          <% if flash[:alert] %>
            <div class="alert-error"><%= flash[:alert] %></div>
          <% end %>
          <%= yield %>
        </div>
      </main>

      <div class="console-scrim" data-console-nav-scrim aria-hidden="true"></div>
    </div>

    <script>
      (() => {
        // Mobile navigation drawer. Below the CSS breakpoint the sidebar is
        // off-canvas; the hamburger in the top bar toggles a `console-nav-open`
        // class on the shell that slides it in over a scrim. The drawer closes
        // on scrim click, Escape, following any nav link, and after every Turbo
        // navigation so it never lingers over the freshly loaded page.
        const shell = document.getElementById("console-shell");
        const toggle = document.querySelector("[data-console-nav-toggle]");
        const scrim = document.querySelector("[data-console-nav-scrim]");
        const sidebar = shell && shell.querySelector(".console-sidebar");
        if (!shell || !toggle || !sidebar) return;

        const OPEN_CLASS = "console-nav-open";
        // Mirrors the CSS breakpoint: only in the off-canvas range does a
        // closed drawer need to be pulled out of the tab / assistive-tech order.
        const mobileQuery = window.matchMedia("(max-width: 768px)");

        const isOpen = () => shell.classList.contains(OPEN_CLASS);

        // Off-canvas and closed => hide the sidebar from keyboard and assistive
        // tech: it sits before the page in DOM order, so leaving it merely
        // translated off-screen makes users tab through invisible controls
        // first. Desktop and the open drawer stay fully interactive.
        const syncInert = () => {
          sidebar.inert = mobileQuery.matches && !isOpen();
        };

        const setOpen = (open) => {
          shell.classList.toggle(OPEN_CLASS, open);
          toggle.setAttribute("aria-expanded", String(open));
          syncInert();
        };

        toggle.addEventListener("click", () => setOpen(!isOpen()));
        if (scrim) scrim.addEventListener("click", () => setOpen(false));

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && isOpen()) setOpen(false);
        });

        // Only real navigations should dismiss the drawer. Links (section nav,
        // thread rows, the brand) qualify; in-drawer buttons that open a menu
        // or reveal more rows (account menu, theme toggle, "show more") must
        // not, or they'd slam the drawer shut before doing anything. Form
        // buttons that submit (sign out, view as operator) trigger a full
        // navigation, which the turbo listeners below already close on.
        shell.addEventListener("click", (event) => {
          if (!isOpen()) return;
          if (event.target.closest(".console-sidebar a[href]")) {
            setOpen(false);
          }
        });

        mobileQuery.addEventListener("change", syncInert);
        document.addEventListener("turbo:visit", () => setOpen(false));
        document.addEventListener("turbo:load", () => setOpen(false));

        syncInert();
      })();

      (() => {
        const accountButton = document.getElementById("console-account-menu-button");
        const accountMenu = document.getElementById("console-account-menu");
        if (!accountButton || !accountMenu) return;

        const closeAccountMenu = () => {
          accountMenu.hidden = true;
          accountButton.setAttribute("aria-expanded", "false");
        };

        accountButton.addEventListener("click", () => {
          const expanded = accountButton.getAttribute("aria-expanded") === "true";
          accountMenu.hidden = expanded;
          accountButton.setAttribute("aria-expanded", String(!expanded));
        });

        document.addEventListener("click", (event) => {
          if (accountMenu.hidden) return;
          if (accountButton.contains(event.target) || accountMenu.contains(event.target)) return;
          closeAccountMenu();
        });

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") closeAccountMenu();
        });
      })();

      (() => {
        // Channel disclosures in the thread sidebar. Collapsed channels are
        // remembered so the sidebar looks the same across visits.
        const CHANNEL_COLLAPSE_KEY = "console:collapsed-channels";
        const collapsedChannels = () => {
          try {
            const raw = window.localStorage.getItem(CHANNEL_COLLAPSE_KEY);
            return new Set(raw ? JSON.parse(raw) : []);
          } catch {
            return new Set();
          }
        };
        const persistCollapsedChannels = set => {
          try {
            window.localStorage.setItem(CHANNEL_COLLAPSE_KEY, JSON.stringify([...set]));
          } catch {
            /* private mode: the toggle still works for this page */
          }
        };
        const syncChannelGroups = () => {
          const collapsed = collapsedChannels();
          document.querySelectorAll("[data-console-channel-group]").forEach(group => {
            const name = group.getAttribute("data-console-channel-group");
            const toggle = group.querySelector("[data-console-channel-toggle]");
            const threads = group.querySelector("[data-console-channel-threads]");
            if (!toggle || !threads) return;
            const isCollapsed = collapsed.has(name);
            toggle.setAttribute("aria-expanded", isCollapsed ? "false" : "true");
            threads.hidden = isCollapsed;
          });
        };
        // This inline script re-runs on every Turbo visit, so the listeners are
        // registered once per document: a second click listener would toggle the
        // channel straight back and look like nothing happened.
        if (!window.__consoleChannelTogglesBound) {
          window.__consoleChannelTogglesBound = true;
          document.addEventListener("click", event => {
            const target = event.target instanceof Element ? event.target : null;
            const toggle = target?.closest("[data-console-channel-toggle]");
            if (!toggle) return;
            const group = toggle.closest("[data-console-channel-group]");
            const name = group && group.getAttribute("data-console-channel-group");
            if (!name) return;
            event.preventDefault();
            const collapsed = collapsedChannels();
            if (collapsed.has(name)) {
              collapsed.delete(name);
            } else {
              collapsed.add(name);
            }
            persistCollapsedChannels(collapsed);
            window.__consoleSyncChannelGroups?.();
          });
          document.addEventListener("turbo:load", () => window.__consoleSyncChannelGroups?.());
          document.addEventListener("turbo:frame-load", () => window.__consoleSyncChannelGroups?.());
        }
        window.__consoleSyncChannelGroups = syncChannelGroups;
        syncChannelGroups();

        const themeToggle = document.querySelector("[data-console-theme-toggle]");
        if (!themeToggle) return;

        const root = document.documentElement;
        const label = themeToggle.querySelector("[data-console-theme-label]");
        const lightIcon = themeToggle.querySelector("[data-console-theme-icon='light']");
        const darkIcon = themeToggle.querySelector("[data-console-theme-icon='dark']");
        const systemIcon = themeToggle.querySelector("[data-console-theme-icon='system']");
        const themePreferences = ["system", "light", "dark"];
        const themeLabels = {
          system: "System mode",
          light: "Light mode",
          dark: "Dark mode"
        };

        const nextThemePreference = (preference) => {
          const currentIndex = themePreferences.indexOf(preference);
          return themePreferences[(currentIndex + 1) % themePreferences.length];
        };

        const syncThemeControl = (preference) => {
          const nextPreference = nextThemePreference(preference);
          if (label) label.textContent = themeLabels[preference];
          themeToggle.setAttribute(
            "aria-label",
            `Current theme: ${preference}. Switch to ${nextPreference} mode`
          );
          themeToggle.dataset.consoleThemePreference = preference;
          if (lightIcon) lightIcon.hidden = preference !== "light";
          if (darkIcon) darkIcon.hidden = preference !== "dark";
          if (systemIcon) systemIcon.hidden = preference !== "system";
        };

        const applyTheme = (preference, persist = false) => {
          if (window.ConsoleTheme) {
            if (persist) window.ConsoleTheme.persist(preference);
            else window.ConsoleTheme.apply(preference);
          } else {
            const useLightTheme = preference === "light" ||
              (preference === "system" && window.matchMedia?.("(prefers-color-scheme: light)").matches);
            const nextTheme = useLightTheme ? "light" : "dark";
            root.dataset.consoleTheme = nextTheme;
          }
          syncThemeControl(preference);
        };

        applyTheme(window.ConsoleTheme?.preference?.() || root.dataset.consoleTheme || "dark");
        themeToggle.addEventListener("click", () => {
          const currentPreference = themeToggle.dataset.consoleThemePreference || "system";
          applyTheme(nextThemePreference(currentPreference), true);
        });
      })();

      (() => {
        // The thread list is loaded lazily into a Turbo Frame, so the show-more
        // button does not exist on initial page load. Wire it up both now (in
        // case the frame is already populated) and each time the frame loads.
        const wireShowMore = () => {
          const showMoreButton = document.querySelector("[data-console-thread-show-more]");
          if (!showMoreButton || showMoreButton.dataset.consoleThreadShowMoreWired === "true") return;

          const list = showMoreButton.closest(".console-thread-list");
          if (!list) return;

          const revealNextThreads = () => {
            const pageSize = Number.parseInt(showMoreButton.dataset.pageSize || "5", 10);
            const hiddenThreads = Array.from(list.querySelectorAll(".console-thread-link-hidden"));
            hiddenThreads.slice(0, Number.isFinite(pageSize) ? pageSize : 5).forEach((link) => {
              link.classList.remove("console-thread-link-hidden");
            });

            if (!list.querySelector(".console-thread-link-hidden")) {
              showMoreButton.hidden = true;
            }
          };

          if (!list.querySelector(".console-thread-link-hidden")) {
            showMoreButton.hidden = true;
          } else {
            showMoreButton.addEventListener("click", revealNextThreads);
          }
          showMoreButton.dataset.consoleThreadShowMoreWired = "true";
        };

        wireShowMore();
        document.addEventListener("turbo:frame-load", (event) => {
          if (event.target && event.target.id === "console_sidebar_threads") wireShowMore();
        });
      })();

      (() => {
        // The sidebar thread list is turbo-permanent, so it is not re-rendered
        // when navigating between threads. Re-derive the active highlight from
        // the page URL after every Turbo visit and after the frame's initial
        // lazy load, un-hiding an open thread that sits in the collapsed tail.
        const THREADS_PATH = "<%= console_threads_path %>";

        const syncSidebarActiveThreads = () => {
          const url = new URL(window.location.href);
          const openKeys = url.pathname.startsWith(THREADS_PATH)
            ? (url.searchParams.get("thread") || "").split(",").filter(Boolean)
            : [];

          document.querySelectorAll("[data-console-thread-link]").forEach((link) => {
            // The New chat tab participates in open/close clicks but is not a
            // thread row: no open-dot or pane-number decoration.
            if (link.dataset.consoleNewChat !== undefined) return;
            const key = new URL(link.href, window.location.origin).searchParams.get("thread");
            const paneIndex = openKeys.indexOf(key);
            const open = paneIndex !== -1;
            link.classList.toggle("console-thread-link-open", open);
            if (open) {
              // Dot for a single open thread; numbers once a second pane opens.
              if (openKeys.length > 1) {
                link.dataset.consolePaneIndex = String(paneIndex + 1);
              } else {
                delete link.dataset.consolePaneIndex;
              }
              link.classList.remove("console-thread-link-hidden");
            } else {
              delete link.dataset.consolePaneIndex;
            }
          });
        };

        // A chat the turbo-permanent list has never seen (just started from
        // the composer, or older than the list window) appears immediately as
        // an optimistic row, then the frame refetches so the server's row,
        // title, and ordering replace it.
        const SIDEBAR_THREADS_PATH = "<%= console_sidebar_threads_path %>";

        const ensureActiveThreadRow = () => {
          const url = new URL(window.location.href);
          if (!url.pathname.startsWith(THREADS_PATH)) return;
          const openKeys = (url.searchParams.get("thread") || "").split(",").filter(Boolean);
          const primary = openKeys[0];
          // "new" is the composer-pane sentinel, not a thread.
          if (!primary || primary === "new") return;

          const frame = document.getElementById("console_sidebar_threads");
          if (!frame) return;
          // Still on the lazy-load placeholder: the initial fetch carries the
          // thread param and will include this chat on its own.
          if (!frame.querySelector("[data-console-thread-link], .console-thread-empty")) return;

          const known = Array.from(frame.querySelectorAll("[data-console-thread-link]")).some((link) =>
            new URL(link.href, window.location.origin).searchParams.get("thread") === primary
          );
          if (known) return;

          frame.querySelector(".console-thread-empty")?.remove();
          const title = document.querySelector(".console-thread-detail-header h1")?.textContent?.trim() || primary;
          const link = document.createElement("a");
          link.href = `${THREADS_PATH}?thread=${encodeURIComponent(primary)}`;
          link.className = "console-thread-link";
          link.setAttribute("data-console-thread-link", "true");
          link.title = title;
          const titleSpan = document.createElement("span");
          titleSpan.className = "console-thread-title";
          titleSpan.textContent = title;
          const timeSpan = document.createElement("span");
          timeSpan.className = "console-thread-time";
          timeSpan.textContent = "now";
          link.append(titleSpan, timeSpan);
          frame.prepend(link);
          syncSidebarActiveThreads();

          const src = new URL(SIDEBAR_THREADS_PATH, window.location.origin);
          src.searchParams.set("thread", openKeys.join(","));
          frame.setAttribute("src", src.toString());
        };

        document.addEventListener("turbo:load", () => {
          syncSidebarActiveThreads();
          ensureActiveThreadRow();
        });
        document.addEventListener("turbo:frame-load", (event) => {
          if (event.target && event.target.id === "console_sidebar_threads") syncSidebarActiveThreads();
        });
      })();

      (() => {
        // Sidebar thread clicks against the split-view grid. The thread param
        // carries up to PANEL_LIMIT comma-separated keys in grid order.
        //   - Cmd/Ctrl-click on an already-open thread closes it
        //   - plain click on an already-open thread is a no-op
        //   - Cmd/Ctrl-click on a closed thread adds it as a pane
        //   - plain click on a closed thread falls through to Turbo (replaces
        //     the selection with that single thread)
        // Capture phase so the close case wins over Turbo's own link handling;
        // delegated on document because the list arrives via a lazy frame.
        const THREADS_PATH = "<%= console_threads_path %>";
        const PANEL_LIMIT = <%= Console::ThreadsController::PANEL_LIMIT %>;

        document.addEventListener("click", (event) => {
          const link = event.target.closest("[data-console-thread-link]");
          if (!link) return;

          const key = new URL(link.href, window.location.origin).searchParams.get("thread");
          if (!key) return;

          const current = new URL(window.location.href);
          const openKeys = current.pathname.startsWith(THREADS_PATH)
            ? (current.searchParams.get("thread") || "").split(",").filter(Boolean)
            : [];
          const isOpen = openKeys.includes(key);
          const modified = event.metaKey || event.ctrlKey;

          if (isOpen && !modified) {
            event.preventDefault();
            event.stopPropagation();
            return;
          }

          let nextKeys;
          if (isOpen) {
            nextKeys = openKeys.filter((openKey) => openKey !== key);
          } else if (modified) {
            nextKeys = [...openKeys, key];
            // Keep the primary thread and the newest panes when over the limit.
            if (nextKeys.length > PANEL_LIMIT) {
              nextKeys = [nextKeys[0], ...nextKeys.slice(-(PANEL_LIMIT - 1))];
            }
          } else {
            return;
          }

          event.preventDefault();
          event.stopPropagation();

          const next = new URL(THREADS_PATH, window.location.origin);
          if (nextKeys.length) {
            next.searchParams.set("thread", nextKeys.join(","));
          } else {
            // Closing the last open thread lands on the empty state instead of
            // bouncing straight back via the auto-select redirect.
            next.searchParams.set("new", "1");
          }

          // Turbo visit keeps the turbo-permanent sidebar list mounted; a
          // plain location.assign would full-load and repaint it.
          if (window.Turbo) {
            window.Turbo.visit(next.toString());
          } else {
            window.location.assign(next.toString());
          }
        }, true);
      })();
    </script>
  </body>
</html>
